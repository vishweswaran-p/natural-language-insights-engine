{
  "name": "@nlie/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Natural Language Insights Engine backend (Sails + TypeScript, Ports & Adapters).",
  "main": "dist/app.js",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/app.js",
    "dev": "npm run build && node dist/app.js",
    "worker": "node dist/worker.js",
    "worker:dev": "npm run build && node dist/worker.js"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.4",
    "dotenv": "^16.4.0",
    "pg": "^8.13.0",
    "sails": "^1.5.14"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
