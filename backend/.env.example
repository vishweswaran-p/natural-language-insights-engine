# PostgreSQL connection string used by the backend.
# Copy this file to `.env` and adjust as needed for local development.
# Host port must match the one published in docker-compose.yml.
DATABASE_URL=postgresql://insights:insights@localhost:5435/insights

# LLM provider used to answer questions. One of: openai | local
# The application selects the adapter at boot; switching providers is env-only.
LLM_PROVIDER=openai

# Hosted (OpenAI-compatible). Required when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local (Ollama, OpenAI-compatible). Used when LLM_PROVIDER=local.
# Run `ollama serve` and `ollama pull qwen2.5-coder:7b` first.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b
