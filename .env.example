# Optional overrides for `docker compose` (variable substitution).
# Copy to `.env` in the repo root:  cp .env.example .env
#
# When running the app on the host (`npm run dev:backend`), use backend/.env instead.

# Log level: error | warn | info | debug
LOG_LEVEL=info

# LLM provider: local (Ollama in Docker) or openai (hosted).
LLM_PROVIDER=local

# Local Ollama model (pulled automatically on first `docker compose up`).
OLLAMA_MODEL=qwen2.5-coder:1.5b

# Hosted OpenAI (set LLM_PROVIDER=openai and provide a key).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
